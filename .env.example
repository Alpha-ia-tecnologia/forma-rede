# FORMAREDE - modelo do ambiente LOCAL (copie para .env.desenvolvimento.local e rode com
# set -a; . ./.env.desenvolvimento.local; set +a). O .env guarda os valores de producao,
# prontos para colar no Easypanel; veja o README, secao Deploy.

# ---------- api ----------
# Banco (PostgreSQL 16+). Localmente a API conecta como dono e o RLS nao vale.
DATABASE_URL="postgresql://formarede:formarede@localhost:5432/formarede?schema=public"
# So para db push e rls (mudar o schema); a API em execucao nao usa.
DIRECT_URL="postgresql://formarede:formarede@localhost:5432/formarede?schema=public"
API_PORT=3333
# Enderecos da web que podem chamar a API, separados por virgula.
CORS_ORIGINS="http://localhost:3000"
# Em producao: openssl rand -hex 32 (com este valor a API nao sobe em producao).
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# A web nao renova o token; em producao use algo como 8h.
JWT_EXPIRES_IN="15m"

# IA: o Copiloto usa o provider do municipio (padrao "deepseek", ou "anthropic" e "mock",
# deterministico e sem chave); o Assistente usa a Anthropic.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
ANTHROPIC_API_KEY=""

# ---------- worker ----------
REDIS_URL="redis://localhost:6379"

# ---------- web ----------
# Entram no build. Para os dados de demonstracao (sem API nem banco), descomente; o
# apps/web/.env.local tambem serve, mas uma variavel definida aqui vale mais que ele.
# NEXT_PUBLIC_MOCK=1
NEXT_PUBLIC_API_URL="http://localhost:3333"
