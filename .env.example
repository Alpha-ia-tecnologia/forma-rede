# ---------- Banco de dados (PostgreSQL 16 + pgvector) ----------
DATABASE_URL="postgresql://formarede:formarede@localhost:5432/formarede?schema=public"
DIRECT_URL="postgresql://formarede:formarede@localhost:5432/formarede?schema=public"

# ---------- Redis (filas BullMQ) ----------
REDIS_URL="redis://localhost:6379"

# ---------- Autenticação ----------
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- API ----------
API_PORT=3333
API_URL="http://localhost:3333"
CORS_ORIGINS="http://localhost:3000"

# ---------- Web ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ---------- Gateway de IA (multi-provider) ----------
# Provider padrao: "deepseek" (defina DEEPSEEK_API_KEY).
# Alternativas na tela "IA governada": "anthropic" (claude-opus-4-8, requer
# ANTHROPIC_API_KEY) ou "mock" (deterministico, roda sem chave).
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
ANTHROPIC_API_KEY=""
