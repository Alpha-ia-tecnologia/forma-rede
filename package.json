{
  "name": "formarede",
  "version": "0.1.0",
  "private": true,
  "description": "FORMAREDE — Plataforma multi-tenant de formação e acompanhamento de professores",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @formarede/db generate",
    "db:migrate": "pnpm --filter @formarede/db migrate",
    "db:rls": "pnpm --filter @formarede/db rls",
    "db:seed": "pnpm --filter @formarede/db seed",
    "db:reset": "pnpm --filter @formarede/db reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "bootstrap": "pnpm infra:up && pnpm db:migrate && pnpm db:rls && pnpm db:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
